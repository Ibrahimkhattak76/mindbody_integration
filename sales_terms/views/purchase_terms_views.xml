<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form view -->
    <record id="view_purchase_terms_form" model="ir.ui.view">
        <field name="name">sale.terms.form</field>
        <field name="model">sale.terms</field>
        <field name="arch" type="xml">
            <form string="Terms and Conditions">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="content"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view -->
    <record id="view_purchase_terms_tree" model="ir.ui.view">
        <field name="name">sale.terms.tree</field>
        <field name="model">sale.terms</field>
        <field name="arch" type="xml">
            <list string="Terms and Conditions">
                <field name="name"/>
                <field name="content"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_terms_and_conditions" model="ir.actions.act_window">
        <field name="name">Terms and Conditions</field>
        <field name="res_model">sale.terms</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu (Sales → Configuration) -->
    <record id="menu_terms_and_conditions" model="ir.ui.menu">
        <field name="name">Terms and Conditions</field>
        <field name="parent_id" ref="sale.menu_sale_config"/>
        <field name="sequence" eval="10"/>
        <field name="action" ref="action_terms_and_conditions"/>
    </record>
</odoo>
