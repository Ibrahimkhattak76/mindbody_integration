<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--        Staff - List & Form View                               -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <record id="view_mindbody_staff_tree" model="ir.ui.view">
        <field name="name">mindbody.staff.list</field>
        <field name="model">mindbody.staff</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>

                </header>
                <field name="staff_id"/>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="display_name"/>
                <field name="email"/>
                <field name="appointment_instructor"/>
                <field name="class_teacher"/>
            </list>
        </field>
    </record>

    <!-- ================================================ -->
    <!--         Staff - Form View                         -->
    <!-- ================================================ -->

    <record id="view_mindbody_staff_form" model="ir.ui.view">
        <field name="name">mindbody.staff.form</field>
        <field name="model">mindbody.staff</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="staff_id"/>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="display_name"/>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="bio"/>
                        </group>

                        <group string="Role &amp; Details">
                            <field name="image_url"/>
                            <field name="appointment_instructor"/>
                            <field name="class_teacher"/>
                            <field name="class_assistant"/>
                            <field name="independent_contractor"/>
                            <field name="is_male"/>
                            <field name="sort_order"/>
                        </group>
                    </group>

                    <group string="Contact Information">
                        <field name="address"/>
                        <field name="city"/>
                        <field name="state"/>
                        <field name="postal_code"/>
                        <field name="country"/>
                        <field name="work_phone"/>
                        <field name="home_phone"/>
                        <field name="mobile_phone"/>
                    </group>

                    <group string="Employment">
                        <field name="employment_start"/>
                        <field name="employment_end"/>
                        <field name="emp_id"/>
                        <field name="provider_ids"/>
                    </group>

                    <notebook>
                        <page string="Settings">
                            <field name="staff_settings_id"/>
                            <group>
                                <!-- todo fx -->
                                <!-- <field name="staff_settings_id/use_staff_nicknames"/> -->
                                <!-- <field name="staff_settings_id/show_staff_last_names_on_schedules"/> -->
                            </group>
                        </page>

                        <page string="Appointments">
                            <field name="appointment_ids" mode="list">
                                <list>
                                    <field name="appointment_id"/>
                                    <field name="start_date_time"/>
                                    <field name="client_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <page string="Unavailabilities">
                            <field name="unavailability_ids" mode="list">
                                <list>
                                    <field name="unavailability_id"/>
                                    <field name="start_date_time"/>
                                    <field name="end_date_time"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>

                        <page string="Availabilities">
                            <field name="availability_ids" mode="list">
                                <list>
                                    <field name="availability_id"/>
                                    <field name="start_date_time"/>
                                    <field name="end_date_time"/>
                                    <field name="location_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <field name="pagination_response_id"/>
                </sheet>
            </form>
        </field>
    </record>
