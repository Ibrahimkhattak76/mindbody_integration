<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ============================================ -->
    <!-- Appointment -->
    <!-- ============================================ -->
    <record id="view_mindbody_appointment_tree" model="ir.ui.view">
        <field name="name">mindbody.appointment.list</field>
        <field name="model">mindbody.appointment</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
                </header>
                <field name="appointment_id"/>
                <field name="start_date_time"/>
                <field name="client_id"/>
                <field name="staff_id"/>
                <field name="status"/>
                <field name="duration"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_appointment_form" model="ir.ui.view">
        <field name="name">mindbody.appointment.form</field>
        <field name="model">mindbody.appointment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="appointment_id"/>
                            <field name="gender_preference"/>
                            <field name="duration"/>
                            <field name="provider_id"/>
                            <field name="status"/>
                            <field name="start_date_time"/>
                            <field name="end_date_time"/>
                            <field name="notes"/>
                        </group>
                        <group>
                            <field name="partner_external_id"/>
                            <field name="staff_requested"/>
                            <field name="program_id"/>
                            <field name="session_type_id"/>
                            <field name="location_id"/>
                            <field name="staff_id"/>
                            <field name="staff_external_id"/>
                            <field name="client_id"/>
                            <field name="first_appointment"/>
                            <field name="is_waitlist"/>
                            <field name="waitlist_entry_id"/>
                            <field name="client_service_id"/>
                            <field name="online_description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resources">
                            <field name="resource_ids" mode="list">
                                <list>
                                    <field name="resource_id"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Add Ons">
                            <field name="add_on_ids" mode="list">
                                <list>
                                    <field name="add_on_id"/>
                                    <field name="name"/>
                                    <field name="staff_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Itinerary">
                            <field name="itinerary_ids" mode="list">
                                <list>
                                    <field name="appointment_id"/>
                                    <field name="start_date_time"/>
                                    <field name="duration"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="pagination_response_id"/>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ============================================ -->
    <!-- Appointment Add On -->
    <!-- ============================================ -->
    <record id="view_mindbody_appointment_add_on_tree" model="ir.ui.view">
        <field name="name">mindbody.appointment.add.on.list</field>
        <field name="model">mindbody.appointment.add.on</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
                </header>
                <field name="appointment_id"/>
                <field name="add_on_id"/>
                <field name="name"/>
                <field name="staff_id"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_appointment_add_on_form" model="ir.ui.view">
        <field name="name">mindbody.appointment.add.on.form</field>
        <field name="model">mindbody.appointment.add.on</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="appointment_id"/>
                        <field name="appointment_cart_id"/>
                        <field name="staff_appointment_id"/>
                        <field name="add_on_id"/>
                        <field name="name"/>
                        <field name="staff_id"/>
                        <field name="type_id"/>
                        <field name="num_deducted"/>
                        <field name="category_id"/>
                        <field name="category"/>
                        <field name="session_type_id"/>
                        <field name="start_time"/>
                        <field name="duration_override_in_minutes"/>
                        <field name="notes"/>
                        <field name="pagination_response_id"/>
                    </group>
                    <notebook>
                        <page string="Resources">
                            <field name="resource_ids" mode="list">
                                <list>
                                    <field name="resource_id"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ============================================ -->
    <!-- Appointment Resource -->
    <!-- ============================================ -->
    <record id="view_mindbody_appointment_resource_tree" model="ir.ui.view">
        <field name="name">mindbody.appointment.resource.list</field>
        <field name="model">mindbody.appointment.resource</field>
