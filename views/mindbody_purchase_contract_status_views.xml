<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ============================================ -->
    <!-- Purchase Contract Status -->
    <!-- ============================================ -->
    <record id="view_mindbody_purchase_contract_status_tree" model="ir.ui.view">
        <field name="name">mindbody.purchase.contract.status.list</field>
        <field name="model">mindbody.purchase.contract.status</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="client_id"/>
                <field name="unique_client_id"/>
                <field name="location_id"/>
                <field name="contract_id"/>
                <field name="client_contract_id"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_purchase_contract_status_form" model="ir.ui.view">
        <field name="name">mindbody.purchase.contract.status.form</field>
        <field name="model">mindbody.purchase.contract.status</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="client_id"/>
                        <field name="unique_client_id"/>
                        <field name="location_id"/>
                        <field name="contract_id"/>
                        <field name="client_contract_id"/>
                        <field name="totals_id"/>
                    </group>
                    <notebook>
                        <page string="Payment Failures">
                            <field name="payment_processing_failure_ids" mode="list">
                                <list>
                                    <field name="error_type"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Actions -->
    <record id="action_mindbody_purchase_contract_status" model="ir.actions.act_window">
        <field name="name">Purchase Contract Status</field>
        <field name="res_model">mindbody.purchase.contract.status</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
