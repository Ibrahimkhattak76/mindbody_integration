<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--        Product - List & Form View                             -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

    <record id="view_mindbody_product_tree" model="ir.ui.view">
        <field name="name">mindbody.product.list</field>
        <field name="model">mindbody.product</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
                </header>
                <field name="product_id"/>
                <field name="name"/>
                <field name="price"/>
                <field name="online_price"/>
            </list>
        </field>
    </record>

    <!-- ================================================ -->
    <!--             Product - Form View                  -->
    <!-- ================================================ -->

    <record id="view_mindbody_product_form" model="ir.ui.view">
        <field name="name">mindbody.product.form</field>
        <field name="model">mindbody.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="product_id"/>
                            <field name="product_uuid"/>
                            <field name="name"/>
                            <field name="short_description"/>
                            <field name="long_description"/>
                        </group>

                        <group string="Category &amp; Type">
                            <field name="category_id"/>
                            <field name="sub_category_id"/>
                            <field name="secondary_category_id"/>
                            <field name="type_group"/>
                            <field name="group_id"/>
                        </group>

                        <group string="Pricing">
                            <field name="price"/>
                            <field name="online_price"/>
                            <field name="tax_included"/>
                            <field name="tax_rate"/>
                        </group>

                        <group string="Supplier &amp; Attributes">
                            <field name="supplier_id"/>
                            <field name="supplier_name"/>
                            <field name="manufacturer_id"/>
                            <field name="color_id"/>
                            <field name="size_id"/>
                            <field name="image_url"/>
                        </group>

                        <field name="pagination_response_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ============================================ -->
    <!-- Product Color -->
    <!-- ============================================ -->
    <record id="view_mindbody_product_color_tree" model="ir.ui.view">
        <field name="name">mindbody.product.color.list</field>
        <field name="model">mindbody.product.color</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="color_id"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_product_color_form" model="ir.ui.view">
        <field name="name">mindbody.product.color.form</field>
        <field name="model">mindbody.product.color</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="color_id"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ============================================ -->
    <!-- Product Size -->
    <!-- ============================================ -->
    <record id="view_mindbody_product_size_tree" model="ir.ui.view">
        <field name="name">mindbody.product.size.list</field>
        <field name="model">mindbody.product.size</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="size_id"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_product_size_form" model="ir.ui.view">
        <field name="name">mindbody.product.size.form</field>
        <field name="model">mindbody.product.size</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="size_id"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ============================================ -->
    <!-- Product Inventory -->
    <!-- ============================================ -->
    <record id="view_mindbody_product_inventory_tree" model="ir.ui.view">
        <field name="name">mindbody.product.inventory.list</field>
        <field name="model">mindbody.product.inventory</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="product_id"/>
                <field name="barcode_id"/>
                <field name="location_id"/>
                <field name="units_in_stock"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_product_inventory_form" model="ir.ui.view">
        <field name="name">mindbody.product.inventory.form</field>
        <field name="model">mindbody.product.inventory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="General Information">
                        <group>
                            <field name="product_id"/>
                            <field name="barcode_id"/>
                            <field name="location_id"/>
                            <field name="units_logged"/>
                            <field name="units_sold"/>
                            <field name="units_in_stock"/>
                        </group>
                        <group>
                            <field name="reorder_level"/>
                            <field name="max_level"/>
                            <field name="created_date_time_utc"/>
                            <field name="modified_date_time_utc"/>
                            <field name="pagination_response_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Actions -->
    <record id="action_mindbody_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">mindbody.product</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_mindbody_product_color" model="ir.actions.act_window">
        <field name="name">Product Colors</field>
        <field name="res_model">mindbody.product.color</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_mindbody_product_size" model="ir.actions.act_window">
        <field name="name">Product Sizes</field>
        <field name="res_model">mindbody.product.size</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_mindbody_product_inventory" model="ir.actions.act_window">
        <field name="name">Product Inventory</field>
        <field name="res_model">mindbody.product.inventory</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
