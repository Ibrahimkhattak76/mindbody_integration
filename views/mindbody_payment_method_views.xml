<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ============================================ -->
    <!-- Payment Method -->
    <!-- ============================================ -->
    <record id="view_mindbody_payment_method_tree" model="ir.ui.view">
        <field name="name">mindbody.payment.method.list</field>
        <field name="model">mindbody.payment.method</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="payment_method_id"/>
                <field name="name"/>
                <field name="payment_type_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_payment_method_form" model="ir.ui.view">
        <field name="name">mindbody.payment.method.form</field>
        <field name="model">mindbody.payment.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="payment_method_id"/>
                        <field name="alt_payment_id"/>
                        <field name="name"/>
                        <field name="payment_type_name"/>
                        <field name="fee"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Actions -->
    <record id="action_mindbody_payment_method" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">mindbody.payment.method</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
