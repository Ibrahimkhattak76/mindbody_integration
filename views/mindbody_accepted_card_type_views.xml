<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ============================================ -->
    <!-- Accepted Card Type -->
    <!-- ============================================ -->
    <record id="view_mindbody_accepted_card_type_tree" model="ir.ui.view">
        <field name="name">mindbody.accepted.card.type.list</field>
        <field name="model">mindbody.accepted.card.type</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_accepted_card_type_form" model="ir.ui.view">
        <field name="name">mindbody.accepted.card.type.form</field>
        <field name="model">mindbody.accepted.card.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Actions -->
    <record id="action_mindbody_accepted_card_type" model="ir.actions.act_window">
        <field name="name">Accepted Card Types</field>
        <field name="res_model">mindbody.accepted.card.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
