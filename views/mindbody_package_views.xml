<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ============================================ -->
    <!-- Package -->
    <!-- ============================================ -->
    <record id="view_mindbody_package_tree" model="ir.ui.view">
        <field name="name">mindbody.package.list</field>
        <field name="model">mindbody.package</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="package_id"/>
                <field name="name"/>
                <field name="discount_percentage"/>
                <field name="sell_online"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_package_form" model="ir.ui.view">
        <field name="name">mindbody.package.form</field>
        <field name="model">mindbody.package</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="package_id"/>
                        <field name="name"/>
                        <field name="discount_percentage"/>
                        <field name="sell_online"/>
                        <field name="pagination_response_id"/>
                    </group>
                    <notebook>
                        <page string="Services">
                            <field name="service_ids" mode="list">
                                <list>
                                    <field name="service_id"/>
                                    <field name="name"/>
                                    <field name="price"/>
                                    <field name="count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Products">
                            <field name="product_ids" mode="list">
                                <list>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ============================================ -->
    <!-- Package Service -->
    <!-- ============================================ -->
    <record id="view_mindbody_package_service_tree" model="ir.ui.view">
        <field name="name">mindbody.package.service.list</field>
        <field name="model">mindbody.package.service</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="package_id"/>
                <field name="service_id"/>
                <field name="name"/>
                <field name="price"/>
                <field name="count"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_package_service_form" model="ir.ui.view">
        <field name="name">mindbody.package.service.form</field>
        <field name="model">mindbody.package.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <!-- General Information -->
                    <group string="General Information">
                        <group>
                            <field name="package_id"/>
                            <field name="service_id"/>
                            <field name="name"/>
                            <field name="price"/>
                            <field name="online_price"/>
                            <field name="tax_included"/>
                            <field name="tax_rate"/>
                            <field name="program_id"/>
                            <field name="product_id"/>
                            <field name="count"/>
                            <field name="membership_id"/>
                        </group>
                        <group>
                            <field name="sell_online"/>
                            <field name="sale_in_contract_only"/>
                            <field name="service_type"/>
                            <field name="expiration_type"/>
                            <field name="expiration_unit"/>
                            <field name="expiration_length"/>
                            <field name="revenue_category"/>
                            <field name="priority"/>
                            <field name="discontinued"/>
                        </group>
                    </group>

                    <!-- Intro Offer and Pricing -->
                    <group string="Intro Offer and Pricing">
                        <group>
                            <field name="is_intro_offer"/>
                            <field name="intro_offer_type"/>
                        </group>
                        <group>
                            <field name="is_third_party_discount_pricing"/>
                            <field name="program"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>
    <!-- ============================================ -->
    <!-- Package Product -->
    <!-- ============================================ -->
    <record id="view_mindbody_package_product_tree" model="ir.ui.view">
        <field name="name">mindbody.package.product.list</field>
        <field name="model">mindbody.package.product</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="package_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="price"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_package_product_form" model="ir.ui.view">
        <field name="name">mindbody.package.product.form</field>
        <field name="model">mindbody.package.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="package_id"/>
                        <field name="product_id"/>
                        <field name="product_uuid"/>
                        <field name="category_id"/>
                        <field name="sub_category_id"/>
                        <field name="secondary_category_id"/>
                        <field name="price"/>
                        <field name="tax_included"/>
                        <field name="tax_rate"/>
                        <field name="group_id"/>
                        <field name="name"/>
                        <field name="online_price"/>
                        <field name="short_description"/>
                        <field name="long_description"/>
                        <field name="type_group"/>
                        <field name="supplier_id"/>
                        <field name="supplier_name"/>
                        <field name="image_url"/>
                        <field name="color_id"/>
                        <field name="size_id"/>
                        <field name="manufacturer_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Actions -->
    <record id="action_mindbody_package" model="ir.actions.act_window">
        <field name="name">Packages</field>
        <field name="res_model">mindbody.package</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_mindbody_package_service" model="ir.actions.act_window">
        <field name="name">Package Services</field>
        <field name="res_model">mindbody.package.service</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_mindbody_package_product" model="ir.actions.act_window">
        <field name="name">Package Products</field>
        <field name="res_model">mindbody.package.product</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
