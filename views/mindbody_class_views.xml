                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="class_id"/>
                <field name="start_date_time"/>
                <field name="class_description_id"/>
                <field name="staff_id"/>
                <field name="location_id"/>
                <field name="total_booked"/>
                <field name="is_canceled"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_class_instance_form" model="ir.ui.view">
        <field name="name">mindbody.class.instance.form</field>
        <field name="model">mindbody.class.instance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="class_schedule_id"/>
                        <field name="class_schedule_id_int"/>
                        <field name="class_id"/>
                        <field name="location_id"/>
                        <field name="resource_id"/>
                        <field name="staff_id"/>
                        <field name="class_description_id"/>
                        <field name="booking_window_id"/>
                    </group>
                    <group string="Capacity">
                        <field name="max_capacity"/>
                        <field name="web_capacity"/>
                        <field name="total_booked"/>
                        <field name="total_signed_in"/>
                        <field name="total_booked_waitlist"/>
                        <field name="web_booked"/>
                        <field name="wait_list_size"/>
                    </group>
                    <group string="Timing">
                        <field name="start_date_time"/>
                        <field name="end_date_time"/>
                        <field name="last_modified_date_time"/>
                    </group>
                    <group string="Status">
                        <field name="is_canceled"/>
                        <field name="substitute"/>
                        <field name="active"/>
                        <field name="is_available"/>
                        <field name="is_waitlist_available"/>
                        <field name="is_enrolled"/>
                        <field name="hide_cancel"/>
                        <field name="booking_status"/>
                    </group>
                    <group>
                        <field name="semester_id"/>
                        <field name="virtual_stream_link"/>
                        <field name="class_notes"/>
                        <field name="theme_name"/>
                    </group>
                    <notebook>
                        <page string="Visits">
                            <field name="visit_ids" mode="list">
                                <list>
                                    <field name="visit_id"/>
                                    <field name="client_id"/>
                                    <field name="signed_in"/>
                                </list>
                            </field>
                        </page>
                        <page string="Clients">
                            <field name="client_ids" mode="list">
                                <list>
                                    <field name="display_name"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
