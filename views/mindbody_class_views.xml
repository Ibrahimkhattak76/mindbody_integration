<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ============================================ -->
    <!-- Class Schedule -->
    <!-- ============================================ -->
    <record id="view_mindbody_class_schedule_tree" model="ir.ui.view">
        <field name="name">mindbody.class.schedule.list</field>
        <field name="model">mindbody.class.schedule</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="class_schedule_id"/>
                <field name="class_description_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="staff_id"/>
                <field name="location_id"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_class_schedule_form" model="ir.ui.view">
        <field name="name">mindbody.class.schedule.form</field>
        <field name="model">mindbody.class.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="class_schedule_id"/>
                        <field name="class_description_id"/>
                        <field name="course_id"/>
                        <field name="semester_id"/>
                        <field name="staff_id"/>
                        <field name="location_id"/>
                        <field name="is_available"/>
                        <field name="external_id"/>
                    </group>
                    <group string="Schedule Days">
                        <field name="day_sunday"/>
                        <field name="day_monday"/>
                        <field name="day_tuesday"/>
                        <field name="day_wednesday"/>
                        <field name="day_thursday"/>
                        <field name="day_friday"/>
                        <field name="day_saturday"/>
                    </group>
                    <group string="Schedule Times">
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group string="Enrollment Settings">
                        <field name="allow_open_enrollment"/>
                        <field name="allow_date_forward_enrollment"/>
                    </group>
                    <notebook>
                        <page string="Classes">
                            <field name="class_ids" mode="list">
                                <list>
                                    <field name="class_id"/>
                                    <field name="start_date_time"/>
                                    <field name="total_booked"/>
                                </list>
                            </field>
                        </page>
                        <page string="Clients">
                            <field name="client_ids" mode="list">
                                <list>
                                    <field name="display_name"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="pagination_response_id"/>
                </sheet>
            </form>
        </field>
    </record>
