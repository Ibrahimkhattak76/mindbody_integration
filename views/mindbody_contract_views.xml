<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- ============================================ -->
    <!-- Contract -->
    <!-- ============================================ -->
    <record id="view_mindbody_contract_tree" model="ir.ui.view">
        <field name="name">mindbody.contract.list</field>
        <field name="model">mindbody.contract</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="contract_id"/>
                <field name="name"/>
                <field name="sold_online"/>
                <field name="autopay_enabled"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_contract_form" model="ir.ui.view">
        <field name="name">mindbody.contract.form</field>
        <field name="model">mindbody.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="contract_id"/>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="assigns_membership_id"/>
                        <field name="assigns_membership_name"/>
                        <field name="sold_online"/>
                        <field name="intro_offer"/>
                        <field name="agreement_terms"/>
                    </group>
                    <notebook>
                        <page string="Contract Items">
                            <field name="contract_item_ids" mode="list">
                                <list>
                                    <field name="item_id"/>
                                    <field name="name"/>
                                    <field name="price"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Autopay">
                            <field name="autopay_schedule_id"/>
                            <group>
                                <field name="number_of_autopays"/>
                                <field name="autopay_trigger_type"/>
                                <field name="action_upon_completion_of_autopays"/>
                                <field name="clients_charged_on"/>
                                <field name="clients_charged_on_specific_date"/>
                                <field name="first_autopay_free"/>
                                <field name="last_autopay_free"/>
                                <field name="autopay_enabled"/>
                            </group>
                        </page>
                        <page string="Pricing">
                            <group>
                                <field name="discount_amount"/>
                                <field name="deposit_amount"/>
                                <field name="first_payment_amount_subtotal"/>
                                <field name="first_payment_amount_tax"/>
                                <field name="first_payment_amount_total"/>
                                <field name="recurring_payment_amount_subtotal"/>
                                <field name="recurring_payment_amount_tax"/>
                                <field name="recurring_payment_amount_total"/>
                                <field name="total_contract_amount_subtotal"/>
                                <field name="total_contract_amount_tax"/>
                                <field name="total_contract_amount_total"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ============================================ -->
    <!-- Contract Item -->
    <!-- ============================================ -->
    <record id="view_mindbody_contract_item_tree" model="ir.ui.view">
        <field name="name">mindbody.contract.item.list</field>
        <field name="model">mindbody.contract.item</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="contract_id"/>
                <field name="item_id"/>
                <field name="name"/>
                <field name="price"/>
                <field name="quantity"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_contract_item_form" model="ir.ui.view">
        <field name="name">mindbody.contract.item.form</field>
        <field name="model">mindbody.contract.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="contract_id"/>
                        <field name="item_id"/>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="item_type"/>
                        <field name="price"/>
                        <field name="quantity"/>
                        <field name="one_time_item"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ============================================ -->
    <!-- Autopay Schedule -->
    <!-- ============================================ -->
    <record id="view_mindbody_autopay_schedule_tree" model="ir.ui.view">
        <field name="name">mindbody.autopay.schedule.list</field>
        <field name="model">mindbody.autopay.schedule</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="frequency_type"/>
                <field name="frequency_value"/>
                <field name="frequency_time_unit"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_autopay_schedule_form" model="ir.ui.view">
        <field name="name">mindbody.autopay.schedule.form</field>
        <field name="model">mindbody.autopay.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="frequency_type"/>
                        <field name="frequency_value"/>
                        <field name="frequency_time_unit"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ============================================ -->
    <!-- Membership Restriction -->
    <!-- ============================================ -->
    <record id="view_mindbody_membership_restriction_tree" model="ir.ui.view">
        <field name="name">mindbody.membership.restriction.list</field>
        <field name="model">mindbody.membership.restriction</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <!--<button name="synchronize" string="Sync" type="object" class="btn btn-secondary" display="always"/>
          -->
                </header>
                <field name="contract_id"/>
                <field name="restriction_id"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_mindbody_membership_restriction_form" model="ir.ui.view">
        <field name="name">mindbody.membership.restriction.form</field>
        <field name="model">mindbody.membership.restriction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="contract_id"/>
                        <field name="restriction_id"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Actions -->
    <record id="action_mindbody_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">mindbody.contract</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_mindbody_contract_item" model="ir.actions.act_window">
        <field name="name">Contract Items</field>
        <field name="res_model">mindbody.contract.item</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_mindbody_autopay_schedule" model="ir.actions.act_window">
        <field name="name">Autopay Schedules</field>
        <field name="res_model">mindbody.autopay.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_mindbody_membership_restriction" model="ir.actions.act_window">
        <field name="name">Membership Restrictions</field>
        <field name="res_model">mindbody.membership.restriction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
